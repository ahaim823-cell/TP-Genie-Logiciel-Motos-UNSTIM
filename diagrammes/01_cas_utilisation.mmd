%% Figure — Diagramme de cas d'utilisation du dispositif de démarrage biométrique
%% Projet : Sécurisation des motos de l'UNSTIM par démarrage biométrique
%% Acteur principal à gauche, acteurs secondaires à droite (convention UML)
%% Noms officiels : voir GLOSSAIRE.md
flowchart LR
    PROP["«acteur»<br/>Propriétaire"]:::acteur

    subgraph SYS["Dispositif de démarrage biométrique"]
        UC1(["Démarrer la moto"]):::principal
        UC2(["Authentifier l'empreinte"]):::inclus
        UC3(["Vérifier le droit d'accès"]):::inclus
        UC4(["Enregistrer l'événement"]):::inclus
        UC5(["Déclencher l'alarme"]):::extension
        UC6(["Consulter l'historique"])
        UC7(["Consulter les alertes"])
        UC8(["Enrôler une empreinte"])
        UC9(["Gérer les utilisateurs, les motos et les autorisations"])
        UC11(["Supprimer une empreinte"])
        UC12(["Synchroniser les données"])
        UC10(["Configurer le dispositif"])
    end

    AGENT["«acteur»<br/>Agent de sécurité"]:::acteur
    ADMIN["«acteur»<br/>Administrateur"]:::acteur

    PROP --- UC1
    UC1 -. "«include»" .-> UC2
    UC1 -. "«include»" .-> UC3
    UC1 -. "«include»" .-> UC4
    UC1 ~~~ UC5
    UC5 -. "«extend»<br/>[3 échecs consécutifs]" .-> UC1

    %% Liens invisibles : placent les cas des acteurs secondaires dans une colonne à droite
    UC3 ~~~ UC6
    UC3 ~~~ UC7
    UC3 ~~~ UC8
    UC3 ~~~ UC9
    UC3 ~~~ UC10
    UC3 ~~~ UC11
    UC3 ~~~ UC12

    UC6 --- AGENT
    UC7 --- AGENT
    UC6 --- ADMIN
    UC8 --- ADMIN
    UC9 --- ADMIN
    UC10 --- ADMIN
    UC11 --- ADMIN
    UC12 --- ADMIN

    classDef acteur fill:#FFFFFF,stroke:#1F3A5F,stroke-width:2px,color:#1F3A5F
    classDef principal fill:#1F3A5F,stroke:#1F3A5F,color:#FFFFFF,font-weight:bold
    classDef inclus fill:#E8F0FA,stroke:#2E6DB4,color:#1F3A5F
    classDef extension fill:#FDECEA,stroke:#C0392B,color:#8E1B10
